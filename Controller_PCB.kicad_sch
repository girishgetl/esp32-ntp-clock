	(text "Controller PCB - ESP32 NTP Clock\nESP32 + MOSFET Drivers + Power Supply\n14-Pin Connector to Display PCB"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "title_text_ctrl")
	)
	(text "SEGMENT DRIVERS (7x AO3400A)\nGPIO → AO3400 Gate\nAO3400 Drain → Connector (SEG_x)\nAO3400 Source → GND\n\nGPIO23→SEG_A, GPIO22→SEG_B\nGPIO21→SEG_C, GPIO5→SEG_D\nGPIO4→SEG_E, GPIO27→SEG_F\nGPIO26→SEG_G"
		(exclude_from_sim no)
		(at 170.18 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "seg_drivers_text")
	)
	(text "DIGIT DRIVERS (4x Level Shifter + P-ch)\nGPIO → AO3400 (N-ch level shifter) Gate\nAO3400 Source → GND\nAO3400 Drain → AO3401A (P-ch) Gate + 100K to 12V\nAO3401A Source → +12V\nAO3401A Drain → Connector (DIG_x)\n\nGPIO16→DIG_1, GPIO17→DIG_2\nGPIO18→DIG_3, GPIO19→DIG_4\n\nLogic: GPIO HIGH → N-ch ON → P-ch Gate 0V → P-ch ON → Digit ON"
		(exclude_from_sim no)
		(at 170.18 100.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "digit_drivers_text")
	)
	(text "COLON DRIVER (1x AO3400A)\nGPIO25 → AO3400 Gate\nAO3400 Drain → Connector Pin 12 (COLON)\nAO3400 Source → GND\n\nLogic: GPIO HIGH → Colon ON"
		(exclude_from_sim no)
		(at 170.18 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "colon_driver_text")
	)
	(text "POWER SUPPLY\nInput: 12V DC\nMini360 Buck: 12V → 3.3V\nDecoupling: 100uF + 100nF on 3.3V rail\n\nEN pin: 10K pull-up to 3.3V + 100nF to GND\nIO0: 10K pull-up to 3.3V (boot mode)"
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "power_text")
	)
	(text "CONNECTOR PINOUT\nPin 1: SEG_A    Pin 8: DIG_1\nPin 2: SEG_B    Pin 9: DIG_2\nPin 3: SEG_C    Pin 10: DIG_3\nPin 4: SEG_D    Pin 11: DIG_4\nPin 5: SEG_E    Pin 12: COLON\nPin 6: SEG_F    Pin 13: +12V\nPin 7: SEG_G    Pin 14: GND"
		(exclude_from_sim no)
		(at 25.4 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "connector_pinout_text")
	)
